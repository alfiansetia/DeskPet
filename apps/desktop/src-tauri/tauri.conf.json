{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskPet",
  "version": "0.1.0",
  "identifier": "com.deskpet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "DeskPet",
        "width": 170,
        "height": 200,
        "minWidth": 80,
        "minHeight": 80,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' https://api.myquran.com https://api.aladhan.com https://api.open-meteo.com https://geocoding-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Local-first desktop companion",
    "longDescription": "DeskPet is a local-first, privacy-first desktop companion. P1 foundation: transparent pet window, placeholder character, tray controls.",
    "windows": {
    },
    "macOS": {
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
