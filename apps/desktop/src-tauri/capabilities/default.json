{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "P1 minimal capabilities: pet window + tray only. No FS/network scopes beyond localhost.",
  "windows": ["pet"],
  "permissions": ["core:default", "core:window:allow-show", "core:window:allow-hide", "core:window:allow-set-always-on-top", "core:window:allow-start-dragging", "core:window:allow-set-position", "core:tray:default", "core:event:default"]
}
